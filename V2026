<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Will You Be My Valentine? 💖</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Pacifico&family=Nunito:wght@400;700&display=swap');

body {
  margin: 0;
  font-family: 'Nunito', sans-serif;
  background: linear-gradient(180deg, #ffd1e8, #ff9ac7);
  color: #b30047;
  text-align: center;
  overflow-x: hidden;
}

section {
  min-height: 100vh;
  padding: 40px 20px;
  display: none;
  justify-content: center;
  align-items: center;
}

section.active {
  display: flex;
}

.card {
  background: #fff0f6;
  border-radius: 25px;
  padding: 30px;
  max-width: 500px;
  width: 100%;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

h1, h2 {
  font-family: 'Pacifico', cursive;
}

button {
  background: #ff4d88;
  color: white;
  border: none;
  padding: 14px 28px;
  margin: 10px;
  border-radius: 30px;
  font-size: 16px;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  transform: scale(1.1);
  background: #ff1f6b;
}

.heart {
  font-size: 60px;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.float-heart {
  position: fixed;
  bottom: -50px;
  font-size: 24px;
  animation: floatUp 6s linear infinite;
  opacity: 0.6;
}

@keyframes floatUp {
  0% { transform: translateY(0); }
  100% { transform: translateY(-110vh); }
}

.gifts {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

.gift {
  background: #ff6fa5;
  padding: 20px;
  border-radius: 20px;
  color: white;
  cursor: pointer;
  width: 120px;
}
</style>
</head>

<body>

<!-- FLOATING HEARTS -->
<script>
for (let i = 0; i < 20; i++) {
  const heart = document.createElement("div");
  heart.className = "float-heart";
  heart.innerText = "💗";
  heart.style.left = Math.random() * 100 + "vw";
  heart.style.animationDuration = 4 + Math.random() * 4 + "s";
  document.body.appendChild(heart);
}
</script>

<!-- INTRO -->
<section class="active" id="intro">
  <div class="card">
    <h1>💐 Your Rose Bouquet</h1>
    <p>I will always love you, no matter what.</p>
    <p>You are the best part of my life 💕</p>
    <button onclick="next('letter')">Next 💌</button>
  </div>
</section>

<!-- LETTER -->
<section id="letter">
  <div class="card">
    <h2>Words from My Heart</h2>
    <p>
      To the love of my life,<br><br>
      You make my life so meaningful and I am beyond lucky to have you.
      I love you wholeheartedly and can’t wait to continue loving you
      for the rest of my life.
      <br><br>
      Always. Forever. ❤️
    </p>
    <button onclick="next('song')">Next 🎵</button>
  </div>
</section>

<!-- SONG -->
<section id="song">
  <div class="card">
    <h2>A Song for You 🎶</h2>

    <!-- REPLACE LINK WITH YOUR SONG -->
    <iframe style="border-radius:12px"
      src="https://open.spotify.com/embed/track/7qiZfU4dY1lWllzX7mPBI3"
      width="100%" height="80" frameborder="0"
      allow="autoplay; clipboard-write; encrypted-media;">
    </iframe>

    <div class="heart">💖</div>
    <button onclick="next('question')">Next 💘</button>
  </div>
</section>

<!-- QUESTION -->
<section id="question">
  <div class="card">
    <h1>Will you be my Valentine? 💕</h1>
    <button onclick="yes()">Yes of course</button>
    <button onclick="no()">No thank you</button>
  </div>
</section>

<!-- TRY AGAIN -->
<section id="tryAgain">
  <div class="card">
    <h2>😢 Try again please</h2>
    <button onclick="next('question')">Try Again</button>
  </div>
</section>

<!-- YES -->
<section id="yesPage">
  <div class="card">
    <h1>🎉 Yay, you said YES!</h1>
    <p>I made all of this just for you 💖</p>

    <canvas id="confetti"></canvas>

    <div class="gifts">
      <div class="gift" onclick="alert('💌 A love letter forever')">Gift 1</div>
      <div class="gift" onclick="alert('🌹 Infinite roses')">Gift 2</div>
      <div class="gift" onclick="alert('🎶 Our song forever')">Gift 3</div>
    </div>
  </div>
</section>

<script>
function next(id) {
  document.querySelectorAll("section").forEach(s => s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
}

function no() {
  next("tryAgain");
}

function yes() {
  next("yesPage");
  confettiBoom();
}

function confettiBoom() {
  for (let i = 0; i < 50; i++) {
    const c = document.createElement("div");
    c.innerText = "🎉";
    c.style.position = "fixed";
    c.style.left = Math.random() * 100 + "vw";
    c.style.top = "100vh";
    c.style.fontSize = "24px";
    c.style.animation = "floatUp 3s linear";
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 3000);
  }
}
</script>

</body>
</html>
